<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- App palette -->
    <Color x:Key="Navy">#2A2D54</Color>
    <Color x:Key="NavySurface">#363A6B</Color>
    <Color x:Key="NavyBorder">#4A4F85</Color>
    <Color x:Key="NavyMuted">#B4B7D9</Color>
    <Color x:Key="Teal">#00C4C0</Color>
    <Color x:Key="Purple">#8C47F5</Color>
    <Color x:Key="MidPurple">#6B3FA0</Color>
    <Color x:Key="DarkPurple">#3D2176</Color>
    <Color x:Key="WarmWhite">#F5F5F5</Color>

    <!-- Signature gradient: teal to purple, left to right -->
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00C4C0" Offset="0.0" />
        <GradientStop Color="#8C47F5" Offset="1.0" />
    </LinearGradientBrush>

    <Color x:Key="Primary">#8C47F5</Color>
    <Color x:Key="PrimaryDark">#6B3FA0</Color>
    <Color x:Key="PrimaryDarkText">#2A2D54</Color>
    <Color x:Key="Secondary">#E9E4F9</Color>
    <Color x:Key="SecondaryDarkText">#B4B7D9</Color>
    <Color x:Key="Tertiary">#3D2176</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#0B0F18</Color>
    <Color x:Key="Magenta">#8C47F5</Color>
    <Color x:Key="MidnightBlue">#2A2D54</Color>
    <Color x:Key="OffBlack">#2A2D54</Color>

    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E3E4EE</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#0B0F18</Color>

    <Color x:Key="Green500">#16A34A</Color>
    <Color x:Key="Red500">#DC2626</Color>
    <Color x:Key="Blue500">#2563EB</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
