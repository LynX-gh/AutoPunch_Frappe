<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TSHR_AutoClock.Pages.CredentialsPage"
             Title="Settings">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" HeightRequest="4" StrokeThickness="0" Background="{StaticResource BrandGradient}" />

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="HRMS Credentials" FontSize="20" FontAttributes="Bold" />

            <Label Text="Saved Credentials" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Picker x:Name="SavedPicker" Title="Select saved credentials" SelectedIndexChanged="OnSavedSelected" />
                <Button x:Name="NewButton" Grid.Column="1" Text="New" Style="{StaticResource SecondaryButton}" Clicked="OnNewClicked" />
                <Button x:Name="DeleteButton" Grid.Column="2" Text="Delete" Style="{StaticResource DangerButton}" Clicked="OnDeleteClicked" IsEnabled="False" />
            </Grid>

            <Label Text="Portal Domain" />
            <Entry x:Name="DomainEntry" Placeholder="e.g. https://your-domain.frappe.cloud" />

            <Label Text="Username" />
            <Entry x:Name="UsernameEntry" Placeholder="Enter username" />

            <Label Text="Password" />
            <Entry x:Name="PasswordEntry" Placeholder="Enter password" IsPassword="True" />

            <HorizontalStackLayout Spacing="12" Margin="0,15,0,0">
                <Button x:Name="SaveButton" Text="Save" Clicked="OnSaveClicked" />
                <Button x:Name="LoginButton" Text="Login" Clicked="OnLoginClicked" />
                <Button x:Name="LogoutButton" Text="Logout" Style="{StaticResource SecondaryButton}" Clicked="OnLogoutClicked" IsVisible="False" />
            </HorizontalStackLayout>

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" />
            <Label x:Name="StatusLabel" TextColor="Gray" FontSize="12" Margin="0,10,0,0" />
            <Label x:Name="ResultLabel" TextColor="{StaticResource Green500}" FontSize="14" Margin="0,5,0,0" />
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>